{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug: AddressSanitizer + UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TIRA_SANITIZE": "address;undefined" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (Clang and LLVM's OpenMP runtime)",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "clang++", "TIRA_SANITIZE": "thread" }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzzing: libFuzzer + AddressSanitizer + UndefinedBehaviorSanitizer (Clang)",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "TIRA_SANITIZE": "address;undefined;fuzzer-no-link",
        "TIRA_FUZZ": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release: optimized, for measuring",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "environment": { "TSAN_OPTIONS": "ignore_noninstrumented_modules=1 halt_on_error=1" }
    },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
